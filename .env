# School Database Management System Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/school_db

# For MongoDB Atlas (Cloud), replace with your connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/school_db?retryWrites=true&w=majority

# JWT Authentication Secret & Expiration
JWT_SECRET=schooldb_jwt_super_secret_key_2025_secure
JWT_EXPIRES_IN=7d

# School Profile Settings
SCHOOL_NAME=Greenfield High School
ACADEMIC_SESSION=2024/2025 Academic Session
CURRENT_TERM=First Term

